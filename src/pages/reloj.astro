---
import MainLayout from "../layouts/ToolLayout.astro";
import Hora from "../components/Hora.astro";
import AuthorBadge from "../components/AuthorBadge.astro";
---

<MainLayout title="Reloj" class="h-screen" reloj="none">
    <main
        class="h-full w-full flex flex-col justify-center items-center text-foreground"
    >
        <div class="text-[4rem] sm:text-[6rem] md:text-[10rem] lg:text-[16rem] xl:text-[23rem] sm:my-32 md:my-48 lg:my-28 xl:my-16">
            <Hora class="h-screen w-full" />
        </div>
        <div class="mt-8 mb-16">
            <AuthorBadge 
                authorName="@Neplod" 
                githubUser="@Neplod" 
            />
        </div>
    </main>
</MainLayout>
