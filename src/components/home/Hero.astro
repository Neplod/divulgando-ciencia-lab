---
// Este componente no necesita JavaScript, es puro HTML/CSS
---

<section
    class="relative overflow-hidden min-h-screen flex items-center pt-15 pb-20 px-4"
>
    <!-- Elementos decorativos flotantes -->
    <div class="absolute inset-0 -z-10">
        <div
            class="absolute top-20 left-10 w-64 h-64 bg-primary/20 rounded-full blur-3xl animate-float"
        >
        </div>
        <div
            class="absolute top-40 right-20 w-80 h-80 bg-accent/20 rounded-full blur-3xl animate-float"
            style="animation-delay: 1s;"
        >
        </div>
        <div
            class="absolute bottom-20 left-1/3 w-72 h-72 bg-secondary/20 rounded-full blur-3xl animate-float"
            style="animation-delay: 2s;"
        >
        </div>
        <div
            class="absolute top-1/2 right-1/4 w-56 h-56 bg-success/20 rounded-full blur-3xl animate-float"
            style="animation-delay: 1.5s;"
        >
        </div>
    </div>

    <!-- Añadido max-w-7xl para limitar el ancho del contenido -->
    <div class="container mx-auto max-w-7xl">
        <div class="flex flex-col items-center text-center space-y-8">
            <!-- Badge -->
            <div
                class="inline-flex items-center gap-2 px-6 py-3 bg-primary/10 rounded-full border-2 border-primary shadow-xl hover:shadow-2xl transition-all hover:scale-110 animate-bounce-in"
            >
                <img
                    src="/images/logo-modo-claro.webp"
                    alt="Logo Divulgando Ciencia Lab"
                    class="w-8 h-8 rounded-full object-cover"
                />

                <span
                    class="font-black text-primary text-base uppercase tracking-wider"
                    >Divulgando Ciencia Lab</span
                >
            </div>

            <!-- Título principal -->
            <h1
                class="text-6xl md:text-8xl lg:text-9xl font-black leading-tight"
            >
                <span class="block text-foreground animate-slide-up"
                    >Experimenta.</span
                >
                <span
                    class="block text-primary animate-slide-up"
                    style="animation-delay: 0.1s;">Aprende.</span
                >
                <span
                    class="block text-accent animate-slide-up"
                    style="animation-delay: 0.2s;">Descubre.</span
                >
            </h1>

            <!-- Descripción -->
            <p
                class="text-2xl md:text-3xl text-foreground/80 max-w-3xl leading-relaxed font-semibold animate-slide-up"
                style="animation-delay: 0.3s;"
            >
                Realiza experimentos científicos increíbles desde tu navegador.
                Sin límites, sin peligros, solo diversión y aprendizaje.
            </p>

            <!-- Botones -->
            <div
                class="flex flex-col sm:flex-row gap-6 pt-6 animate-slide-up"
                style="animation-delay: 0.4s;"
            >
                <a href="#experiments">
                    <button
                        class="bg-primary hover:bg-primary/90 text-primary-foreground text-2xl px-10 py-6 rounded-2xl font-black shadow-2xl hover:shadow-primary/50 transition-all hover:scale-110 hover:-translate-y-1 inline-flex items-center gap-3 group"
                    >
                        <svg
                            class="w-8 h-8 group-hover:rotate-12 transition-transform"
                            fill="currentColor"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                            ></path>
                        </svg>
                        Comenzar Ahora
                        <svg
                            class="w-8 h-8 group-hover:translate-x-2 transition-transform"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="4"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </button>
                </a>
            </div>

            <!-- Imagen -->
            <!--<div class="pt-12 w-full max-w-5xl animate-slide-up" style="animation-delay: 0.5s;">
                <div class="relative rounded-3xl overflow-hidden shadow-2xl border-8 border-primary/30 hover:border-primary/50 transition-all hover:scale-105 hover:-translate-y-2 group">
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <img src="/colorful-science-laboratory-with-beakers--test-tub.jpg" alt="Laboratorio Virtual" class="w-full h-auto" />
                </div>
            </div>-->

            <!-- Estadísticas -->
            <div
                class="grid grid-cols-3 gap-12 pt-16 w-full max-w-4xl animate-slide-up"
                style="animation-delay: 0.6s;"
            >
                <div
                    class="space-y-3 hover:scale-110 transition-transform cursor-pointer group"
                >
                    <div
                        class="text-6xl md:text-7xl font-black text-primary group-hover:animate-pulse"
                    >
                        0
                    </div>
                    <div
                        class="text-base md:text-lg text-foreground/70 font-bold uppercase tracking-wide"
                    >
                        Limitaciones
                    </div>
                </div>
                <div
                    class="space-y-3 hover:scale-110 transition-transform cursor-pointer group"
                >
                    <div
                        class="text-6xl md:text-7xl font-black text-accent group-hover:animate-pulse"
                    >
                        100%
                    </div>
                    <div
                        class="text-base md:text-lg text-foreground/70 font-bold uppercase tracking-wide"
                    >
                        Seguro
                    </div>
                </div>
                <div
                    class="space-y-3 hover:scale-110 transition-transform cursor-pointer group"
                >
                    <div
                        class="text-6xl md:text-7xl font-black text-secondary group-hover:animate-pulse"
                    >
                        ∞
                    </div>
                    <div
                        class="text-base md:text-lg text-foreground/70 font-bold uppercase tracking-wide"
                    >
                        Diversión
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
