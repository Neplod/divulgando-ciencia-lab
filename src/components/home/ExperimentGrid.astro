---
const experiments = [
    {
        id: 1,
        title: "Reloj Digital",
        description: "Visualiza la hora actual con un diseño elegante y minimalista",
        href: "/reloj",
        icon: "clock",
        color: "primary",
        rotation: -15,
    },
    {
        id: 2,
        title: "Analizador de Funciones",
        description: "Estudia funciones cuadráticas, sus gráficas y propiedades",
        href: "/analizar-funciones",
        icon: "activity",
        color: "accent",
        rotation: 15,
    },
    {
        id: 3,
        title: "Adivino tu Carta",
        description: "Un sorprendente truco de magia matemático que leerá tu mente",
        href: "/adivino-tu-carta",
        icon: "star",
        color: "success",
        rotation: -10,
    },
    {
        id: 4,
        title: "Consola Python",
        description: "Programa, prueba y ejecuta código Python directamente en el navegador",
        href: "/console",
        icon: "terminal",
        color: "accent",
        rotation: 10,
    },
    {
        id: 5,
        title: "Q-Bot Reciclaje",
        description: "Asistente inteligente para identificar residuos y aprender a reciclar",
        href: "/q-bot",
        icon: "trash",
        color: "primary",
        rotation: -20,
    },
];

const icons = {
    clock: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />',
    activity: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />',
    star: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />',
    terminal: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 17l6-6-6-6M12 19h8" />',
    trash: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />',
};
---

<section class="py-20 md:py-32 px-4">
    <div class="container mx-auto max-w-7xl">
        <div class="text-center space-y-6 mb-16">
            <a name="experiments"></a>
            <h2
                class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight pb-2"
            >
                Experimentos <span class="text-primary">Increíbles</span>
            </h2>
            <p
                class="text-xl md:text-3xl text-foreground/70 max-w-3xl mx-auto font-bold tracking-tight"
            >
                Elige tu aventura científica y comienza a experimentar
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                experiments.map((experiment, index) => (
                    <a href={experiment.href} class="block group perspective-1000">
                        <div
                            class={`
                                relative overflow-hidden rounded-3xl p-8 h-84 transition-all duration-200
                                border-2 backdrop-blur-md
                                hover:scale-105 hover:-translate-y-2 hover:shadow-[0_0_40px_rgba(var(--${experiment.color}),0.3)]
                                group-hover:border-${experiment.color}/50
                                ${experiment.color === "primary" ? "bg-gradient-to-br from-primary/20 to-primary/5 border-primary/20" : ""}
                                ${experiment.color === "accent" ? "bg-gradient-to-br from-accent/20 to-accent/5 border-accent/20" : ""}
                                ${experiment.color === "success" ? "bg-gradient-to-br from-success/20 to-success/5 border-success/20" : ""}
                            `}
                            style={`animation-delay: ${index * 0.1}s;`}
                        >
                            <!-- Background Glow Effect -->
                            <div class={`absolute -top-20 -right-20 w-64 h-64 rounded-full blur-3xl opacity-10 transition-opacity duration-500 group-hover:opacity-30 bg-${experiment.color}`}></div>
                            
                            <div class="relative z-10 flex flex-col h-full justify-between">
                                <div class="flex items-start justify-between">
                                    <div
                                        class={`experiment-icon p-4 rounded-2xl shadow-lg transition-all duration-500 group-hover:shadow-${experiment.color}/50 bg-gradient-to-br from-white/10 to-white/5 border border-white/10`}
                                        data-rotation={experiment.rotation}
                                    >
                                        <svg
                                            class={`w-10 h-10 text-${experiment.color} drop-shadow-md`}
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            viewBox="0 0 24 24"
                                            set:html={icons[experiment.icon as keyof typeof icons]}
                                        />
                                    </div>
                                </div>

                                <div class="space-y-3 mt-4">
                                    <h3 class="text-3xl font-black text-foreground group-hover:text-${experiment.color} transition-colors duration-300">
                                        {experiment.title}
                                    </h3>
                                    <p class="text-base text-foreground/70 leading-relaxed font-medium line-clamp-2">
                                        {experiment.description}
                                    </p>
                                </div>

                                <div class="pt-4 flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-${experiment.color} opacity-80 group-hover:opacity-100 transition-all translate-y-2 group-hover:translate-y-0">
                                    <span>Explorar</span>
                                    <svg
                                        class="w-5 h-5 group-hover:translate-x-2 transition-transform duration-300"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="3"
                                            d="M14 5l7 7m0 0l-7 7m7-7H3"
                                        />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".experiment-icon").forEach((icon) => {
            const rotation = icon.getAttribute("data-rotation") || "0";
            const element = icon as HTMLElement;

            element.style.transition =
                "all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)";

            const card = icon.closest('.group');
            
            card?.addEventListener(
                "mouseenter",
                () => {
                    element.style.transform = `rotate(${rotation}deg) scale(1.1)`;
                },
            );

            card?.addEventListener(
                "mouseleave",
                () => {
                    element.style.transform = "rotate(0deg) scale(1)";
                },
            );
        });
    });
</script>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }
</style>
