---
import Layout from "../layouts/ToolLayout.astro";
import AuthorBadge from "../components/AuthorBadge.astro";
---

<Layout title="Máquina Enigma" description="Simulador interactivo de la Máquina Enigma de la Segunda Guerra Mundial. Configura rotores, tablero de conexiones, visualiza la ruta de la señal y analiza frecuencias y tiempos en tiempo real.">
    <style is:global>
        .metal-panel {
            background: linear-gradient(145deg, #1f1f23, #151518);
            box-shadow:
                inset 1px 1px 0px rgba(255, 255, 255, 0.05),
                inset -1px -1px 0px rgba(0, 0, 0, 0.4),
                0 10px 30px rgba(0, 0, 0, 0.5);
        }
        .rotor-window {
            background: linear-gradient(to bottom, #0f0f11, #1e1e24, #0f0f11);
            box-shadow:
                inset 0 2px 8px rgba(0, 0, 0, 0.8),
                0 1px 0px rgba(255, 255, 255, 0.05);
        }
        .glow-lamp {
            transition: all 0.15s ease-in-out;
        }
        .glow-lamp.active {
            background: radial-gradient(
                circle,
                #ff9d00 20%,
                #ff5d00 70%,
                #852100 100%
            );
            color: #ffffff !important;
            border-color: #ffaa44;
            box-shadow:
                0 0 20px rgba(255, 93, 0, 0.8),
                inset 0 1px 3px rgba(255, 255, 255, 0.4);
            text-shadow: 0 0 4px rgba(255, 255, 255, 0.8);
            transform: scale(1.05);
        }
        .keyboard-key {
            box-shadow:
                0 4px 0px #18181b,
                0 6px 10px rgba(0, 0, 0, 0.5);
            transition: all 0.05s ease;
        }
        .keyboard-key:active,
        .keyboard-key.active {
            transform: translateY(3px);
            box-shadow:
                0 1px 0px #18181b,
                0 2px 4px rgba(0, 0, 0, 0.5);
        }
        .plugboard-socket::after {
            content: "";
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #09090b;
            box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.8);
        }
        .plugboard-socket.active {
            border-color: var(--color-accent, #4650ff);
            box-shadow: 0 0 12px var(--color-accent, #4650ff);
        }
        .plugboard-socket.connected {
            border-color: var(--color-success, #00d084);
            box-shadow: 0 0 8px rgba(0, 208, 132, 0.4);
        }
        .scrolling-digits {
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .scrollbar-custom::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .scrollbar-custom::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        .scrollbar-custom::-webkit-scrollbar-thumb {
            background: rgba(255, 20, 30, 0.3);
            border-radius: 3px;
        }
        .scrollbar-custom::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 20, 30, 0.5);
        }
    </style>

    <div id="loading-overlay" class="fixed inset-0 bg-zinc-950/95 backdrop-blur-md flex flex-col items-center justify-center z-50 transition-all duration-500">
        <div class="relative w-28 h-28 flex items-center justify-center">
            <div class="absolute inset-0 border-4 border-dashed border-amber-500 rounded-full animate-[spin_10s_linear_infinite] opacity-60"></div>
            <div class="absolute inset-3 border-4 border-double border-primary rounded-full animate-[spin_5s_linear_infinite] [animation-direction:reverse] opacity-70"></div>
            <svg class="w-12 h-12 text-amber-500 animate-pulse" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
        </div>
        <p class="mt-6 text-amber-500 font-sans font-bold text-sm tracking-widest uppercase">
            Divulgando Ciencia Lab
        </p>
        <p id="loading-status" class="mt-2 text-zinc-400 font-mono text-xs">
            Cargando Pyodide WASM (Entorno Python)...
        </p>
    </div>

    <section class="mt-6 w-full justify-center text-center m-auto px-4 sm:px-8 text-foreground flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 rounded-full border border-primary/20 mb-3">
            <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
            <span class="text-xs font-semibold text-primary uppercase tracking-wider">Criptografía Histórica</span>
        </div>
        <h1 class="font-sans font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight mb-3">Máquina Enigma</h1>
        <p class="text-sm sm:text-base max-w-2xl mx-auto text-muted-foreground">
            Explora el funcionamiento de la legendaria máquina de cifrado de la
            Segunda Guerra Mundial. Configura sus rotores, el panel de
            conexiones, escribe mensajes y analiza la señal eléctrica paso a
            paso.
        </p>
        <AuthorBadge 
            authorName="@Neplod" 
            githubUser="@Neplod" 
            repoUrl="https://github.com/Neplod/enigma-machine"
            isOriginalProject={true}
        />
    </section>

    <main id="enigma-dashboard" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 opacity-0 transition-opacity duration-700 pointer-events-none grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-6">
            <div class="metal-panel rounded-3xl p-6 border border-zinc-800 flex flex-col gap-8 relative">
                <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
                    <span class="font-sans font-bold text-xs tracking-wider text-zinc-500 uppercase">ENIGMA M3 SIMULATION - Python</span>
                    <div class="flex gap-2">
                        <span class="w-3 h-3 rounded-full bg-zinc-800 border border-zinc-700 shadow-inner"></span>
                        <span class="w-3 h-3 rounded-full bg-zinc-800 border border-zinc-700 shadow-inner"></span>
                    </div>
                </div>

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> 1. Rotores (Mecánica de Sustitución)
                    </h3>
                    <div class="grid grid-cols-3 gap-4 md:gap-8 bg-zinc-950/60 p-4 md:p-6 rounded-2xl border border-zinc-900 shadow-inner">
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-[10px] font-bold text-zinc-500 tracking-wider">IZQUIERDA (R3)</span>
                            <select id="rotor-select-0" class="w-full text-center bg-zinc-900 border border-zinc-800 rounded-md text-xs font-mono py-1 text-zinc-300 focus:outline-none focus:border-amber-500 transition-colors">
                                <option value="0" selected>Rotor I</option>
                                <option value="1">Rotor II</option>
                                <option value="2">Rotor III</option>
                                <option value="3">Rotor IV</option>
                                <option value="4">Rotor V</option>
                            </select>

                            <div class="flex items-center gap-1.5 mt-2">
                                <button class="rotor-btn-prev text-zinc-500 hover:text-amber-500 focus:outline-none transition-colors p-1" data-rotor="0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path></svg>
                                </button>

                                <div class="rotor-window w-10 h-16 rounded-md border border-zinc-800 flex items-center justify-center overflow-hidden relative">
                                    <div class="absolute inset-0 pointer-events-none z-10 shadow-[inset_0_4px_6px_rgba(0,0,0,0.6),inset_0_-4px_6px_rgba(0,0,0,0.6)]"></div>
                                    <div class="absolute w-full h-8 border-y border-amber-500/20 bg-amber-500/5 top-4 pointer-events-none"></div>
                                    <div id="rotor-scroll-0" class="scrolling-digits font-mono font-bold text-base text-zinc-400" style="transform: translateY(0px);"></div>
                                </div>

                                <button class="rotor-btn-next text-zinc-500 hover:text-amber-500 focus:outline-none transition-colors p-1" data-rotor="0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                                </button>
                            </div>
                        </div>

                        <div class="flex flex-col items-center gap-2">
                            <span class="text-[10px] font-bold text-zinc-500 tracking-wider">MEDIO (R2)</span>
                            <select id="rotor-select-1" class="w-full text-center bg-zinc-900 border border-zinc-800 rounded-md text-xs font-mono py-1 text-zinc-300 focus:outline-none focus:border-amber-500 transition-colors">
                                <option value="0">Rotor I</option>
                                <option value="1" selected>Rotor II</option>
                                <option value="2">Rotor III</option>
                                <option value="3">Rotor IV</option>
                                <option value="4">Rotor V</option>
                            </select>
                            <div class="flex items-center gap-1.5 mt-2">
                                <button class="rotor-btn-prev text-zinc-500 hover:text-amber-500 focus:outline-none transition-colors p-1" data-rotor="1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path></svg>
                                </button>

                                <div class="rotor-window w-10 h-16 rounded-md border border-zinc-800 flex items-center justify-center overflow-hidden relative">
                                    <div class="absolute inset-0 pointer-events-none z-10 shadow-[inset_0_4px_6px_rgba(0,0,0,0.6),inset_0_-4px_6px_rgba(0,0,0,0.6)]"></div>
                                    <div class="absolute w-full h-8 border-y border-amber-500/20 bg-amber-500/5 top-4 pointer-events-none"></div>
                                    <div id="rotor-scroll-1" class="scrolling-digits font-mono font-bold text-base text-zinc-400" style="transform: translateY(0px);"></div>
                                </div>

                                <button class="rotor-btn-next text-zinc-500 hover:text-amber-500 focus:outline-none transition-colors p-1" data-rotor="1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                                </button>
                            </div>
                        </div>
                        <div class="flex flex-col items-center gap-2">
                            <span class="text-[10px] font-bold text-zinc-500 tracking-wider">DERECHA (R1)</span>
                            <select id="rotor-select-2" class="w-full text-center bg-zinc-900 border border-zinc-800 rounded-md text-xs font-mono py-1 text-zinc-300 focus:outline-none focus:border-amber-500 transition-colors">
                                <option value="0">Rotor I</option>
                                <option value="1">Rotor II</option>
                                <option value="2" selected>Rotor III</option>
                                <option value="3">Rotor IV</option>
                                <option value="4">Rotor V</option>
                            </select>

                            <div class="flex items-center gap-1.5 mt-2">
                                <button class="rotor-btn-prev text-zinc-500 hover:text-amber-500 focus:outline-none transition-colors p-1" data-rotor="2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path></svg>
                                </button>

                                <div class="rotor-window w-10 h-16 rounded-md border border-zinc-800 flex items-center justify-center overflow-hidden relative">
                                    <div class="absolute inset-0 pointer-events-none z-10 shadow-[inset_0_4px_6px_rgba(0,0,0,0.6),inset_0_-4px_6px_rgba(0,0,0,0.6)]"></div>
                                    <div class="absolute w-full h-8 border-y border-amber-500/20 bg-amber-500/5 top-4 pointer-events-none"></div>
                                    <div id="rotor-scroll-2" class="scrolling-digits font-mono font-bold text-base text-zinc-400" style="transform: translateY(0px);"></div>
                                </div>

                                <button class="rotor-btn-next text-zinc-500 hover:text-amber-500 focus:outline-none transition-colors p-1" data-rotor="2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> 2. Lampboard (Panel de Luces)
                    </h3>
                    <div class="bg-zinc-950 p-4 md:p-6 rounded-2xl border border-zinc-900/60 shadow-inner flex flex-col gap-3 justify-center items-center select-none">
                        <div class="flex gap-2 justify-center w-full">
                            {
                                ["Q","W","E","R","T","Z","U","I","O",].map((letter) => (
                                    <div class="glow-lamp w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full border border-zinc-800 bg-zinc-900 flex items-center justify-center font-mono font-extrabold text-sm sm:text-base text-zinc-600 shadow-md" data-lamp={letter}>
                                        {letter}
                                    </div>
                                ))
                            }
                        </div>
                        <div class="flex gap-2 justify-center w-full">
                            {
                                ["A", "S", "D", "F", "G", "H", "J", "K"].map(
                                    (letter) => (
                                        <div class="glow-lamp w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full border border-zinc-800 bg-zinc-900 flex items-center justify-center font-mono font-extrabold text-sm sm:text-base text-zinc-600 shadow-md" data-lamp={letter}>
                                            {letter}
                                        </div>
                                    ),
                                )
                            }
                        </div>
                        <div class="flex gap-2 justify-center w-full">
                            {
                                ["P","Y","X","C","V","B","N","M","L",].map((letter) => (
                                    <div class="glow-lamp w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full border border-zinc-800 bg-zinc-900 flex items-center justify-center font-mono font-extrabold text-sm sm:text-base text-zinc-600 shadow-md" data-lamp={letter}>
                                        {letter}
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-4 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> 3. Teclado Físico / Virtual
                    </h3>
                    <div class="bg-zinc-950 p-4 md:p-6 rounded-2xl border border-zinc-900/60 shadow-inner flex flex-col gap-3 justify-center items-center">
                        <div class="flex gap-2 justify-center w-full">
                            {
                                ["Q","W","E","R","T","Z","U","I","O",].map((letter) => (
                                    <button class="keyboard-key w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full border-2 border-zinc-800 bg-linear-to-b from-zinc-700 to-zinc-900 hover:from-zinc-600 hover:to-zinc-800 active:scale-95 text-sm sm:text-base text-zinc-200 font-mono font-bold flex items-center justify-center cursor-pointer select-none" data-key={letter}>
                                        {letter}
                                    </button>
                                ))
                            }
                        </div>
                        <div class="flex gap-2 justify-center w-full">
                            {
                                ["A", "S", "D", "F", "G", "H", "J", "K"].map(
                                    (letter) => (
                                        <button class="keyboard-key w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full border-2 border-zinc-800 bg-linear-to-b from-zinc-700 to-zinc-900 hover:from-zinc-600 hover:to-zinc-800 active:scale-95 text-sm sm:text-base text-zinc-200 font-mono font-bold flex items-center justify-center cursor-pointer select-none" data-key={letter}>
                                            {letter}
                                        </button>
                                    ),
                                )
                            }
                        </div>
                        <div class="flex gap-2 justify-center w-full font-mono">
                            {
                                ["P","Y","X","C","V","B","N","M","L"].map((letter) => (
                                    <button class="keyboard-key w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full border-2 border-zinc-800 bg-linear-to-b from-zinc-700 to-zinc-900 hover:from-zinc-600 hover:to-zinc-800 active:scale-95 text-sm sm:text-base text-zinc-200 font-mono font-bold flex items-center justify-center cursor-pointer select-none" data-key={letter}>
                                        {letter}
                                    </button>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class="relative">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-400 flex items-center gap-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> 4. Plugboard (Tablero de Enchufes)
                        </h3>
                        <button id="btn-clear-plugs" class="text-[10px] font-sans px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-400 hover:text-white rounded border border-zinc-700 transition-colors uppercase cursor-pointer">Quitar Todos</button>
                    </div>
                    <div id="plugboard-container" class="bg-zinc-950 p-4 md:p-6 rounded-2xl border border-zinc-900/60 shadow-inner flex flex-col gap-4 justify-center items-center relative select-none">
                        <svg id="plugboard-svg" class="absolute inset-0 w-full h-full pointer-events-none z-20"></svg>
                        <div class="flex gap-2.5 justify-center w-full relative z-10">
                            {
                                ["Q","W","E","R","T","Z","U","I","O"].map((letter) => (
                                    <div class="flex flex-col items-center gap-1">
                                        <span class="text-[10px] font-bold text-zinc-500">{letter}</span>
                                        <button class="plugboard-socket w-6 h-6 rounded-full border-2 border-zinc-700 bg-zinc-950 flex items-center justify-center cursor-pointer relative" data-plug={letter}></button>
                                    </div>
                                ))
                            }
                        </div>
                        <div class="flex gap-2.5 justify-center w-full relative z-10">
                            {
                                ["A", "S", "D", "F", "G", "H", "J", "K"].map(
                                    (letter) => (
                                        <div class="flex flex-col items-center gap-1">
                                            <span class="text-[10px] font-bold text-zinc-500">{letter}</span>
                                            <button class="plugboard-socket w-6 h-6 rounded-full border-2 border-zinc-700 bg-zinc-950 flex items-center justify-center cursor-pointer relative" data-plug={letter}></button>
                                        </div>
                                    ),
                                )
                            }
                        </div>
                        <div class="flex gap-2.5 justify-center w-full relative z-10">
                            {
                                ["P","Y","X","C","V","B","N","M","L"].map((letter) => (
                                    <div class="flex flex-col items-center gap-1">
                                        <span class="text-[10px] font-bold text-zinc-500">{letter}</span>
                                        <button class="plugboard-socket w-6 h-6 rounded-full border-2 border-zinc-700 bg-zinc-950 flex items-center justify-center cursor-pointer relative" data-plug={letter}></button>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                    <p class="text-[10px] text-zinc-500 mt-2 text-center">
                        Haz clic en una letra y luego en otra para conectarlas.
                        Haz clic en un jack conectado para eliminar su cable.
                        Máximo 13 conexiones.
                    </p>
                </div>
            </div>
        </div>
        <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-6">
            <div class="bg-card text-card-foreground p-5 rounded-2xl border border-border shadow-sm flex flex-col gap-4">
                <h3 class="text-sm font-semibold tracking-wide flex items-center gap-2 border-b border-border pb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>Consola de Mensajes
                </h3>
                <div class="flex flex-col gap-1.5">
                    <label for="input-text" class="text-xs font-medium text-muted-foreground">Texto en Claro (A-Z)</label>
                    <textarea id="input-text" rows="3" placeholder="Escribe aquí tu mensaje (solo letras sin acentos)..." class="w-full bg-input text-foreground border border-input rounded-lg p-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary scrollbar-custom uppercase" style="resize: none;"></textarea>
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="output-text" class="text-xs font-medium text-muted-foreground">Texto Encriptado / Cifrado</label>
                    <textarea id="output-text" rows="3" readonly placeholder="El resultado aparecerá aquí..." class="w-full bg-zinc-950 border border-zinc-900 text-amber-500 font-mono rounded-lg p-3 text-sm focus:outline-none scrollbar-custom" style="resize: none;"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-2 mt-2">
                    <button id="btn-run-all" class="col-span-2 py-2.5 bg-primary hover:bg-primary/95 text-primary-foreground font-sans font-semibold rounded-lg text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>Cifrar / Descifrar Bloque
                    </button>
                    <button id="btn-reset-rotors" class="py-2.5 bg-secondary/20 hover:bg-secondary/30 text-secondary-foreground font-sans font-semibold rounded-lg text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>Reset Rotores
                    </button>
                    <button id="btn-copy" class="py-2.5 bg-accent/10 hover:bg-accent/20 text-shop-black font-sans font-semibold rounded-lg text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
