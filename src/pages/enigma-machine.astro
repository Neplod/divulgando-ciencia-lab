        function renderFrequencyChart() {
            const svg = document.getElementById("frequency-svg");
            if (!svg) return;

            const inputVal = document
                .getElementById("input-text")
                .value.toUpperCase();
            const outputVal = document
                .getElementById("output-text")
                .value.toUpperCase();

            const inputCounts = Array(26).fill(0);
            const outputCounts = Array(26).fill(0);
            let maxCount = 1; 

            for (let char of inputVal) {
                const idx = ALPHABET.indexOf(char);
                if (idx !== -1) {
                    inputCounts[idx]++;
                    if (inputCounts[idx] > maxCount)
                        maxCount = inputCounts[idx];
                }
            }

            for (let char of outputVal) {
                const idx = ALPHABET.indexOf(char);
                if (idx !== -1) {
                    outputCounts[idx]++;
                    if (outputCounts[idx] > maxCount)
                        maxCount = outputCounts[idx];
                }
            }

            const width = 520;
            const height = 180;
            const margin = { left: 20, right: 10, top: 15, bottom: 20 };

            const chartWidth = width - margin.left - margin.right;
            const chartHeight = height - margin.top - margin.bottom;

            const colWidth = chartWidth / 26;

            let svgContent = "";

            const gridLinesCount = 4;
            for (let i = 0; i <= gridLinesCount; i++) {
                const yVal = margin.top + (chartHeight / gridLinesCount) * i;
                const gridVal = Math.round(
                    maxCount - (maxCount / gridLinesCount) * i,
                );
                svgContent += `
                    <line x1="${margin.left}" y1="${yVal}" x2="${width - margin.right}" y2="${yVal}" stroke="#27272a" stroke-width="1" />
                    <text x="${margin.left - 5}" y="${yVal + 3}" fill="#71717a" font-size="8" font-family="monospace" text-anchor="end">${gridVal}</text>
                `;
            }

            for (let k = 0; k < 26; k++) {
                const letter = ALPHABET[k];
                const xBase = margin.left + k * colWidth;
                const barW = (colWidth - 4) / 2;

                const inBarH = (inputCounts[k] / maxCount) * chartHeight;
                const outBarH = (outputCounts[k] / maxCount) * chartHeight;

                const inY = margin.top + chartHeight - inBarH;
                const outY = margin.top + chartHeight - outBarH;

                svgContent += `
                    <rect x="${xBase}" y="${inY}" width="${barW}" height="${inBarH}" fill="var(--color-primary, #ff141e)" fill-opacity="0.75" rx="1" class="transition-all duration-300" />
                `;
                svgContent += `
                    <rect x="${xBase + barW + 1}" y="${outY}" width="${barW}" height="${outBarH}" fill="var(--color-accent, #4650ff)" fill-opacity="0.75" rx="1" class="transition-all duration-300" />
                `;

                svgContent += `
                    <text x="${xBase + colWidth / 2 - 2}" y="${height + 2}" fill="#a1a1aa" font-size="9" font-family="monospace" font-weight="bold" text-anchor="middle">${letter}</text>
                `;
            }

            svg.innerHTML = svgContent;
        }

        function renderSpeedChart() {
            const svg = document.getElementById("speed-svg");
            const avgIndicator = document.getElementById("avg-time-indicator");
            if (!svg) return;

            if (executionTimes.length === 0) {
                svg.innerHTML = `
                    <text x="250" y="100" fill="#71717a" font-size="12" font-family="sans-serif" text-anchor="middle">
                        Escribe o presiona teclas para graficar velocidad de cifrado
                    </text>
                `;
                if (avgIndicator) avgIndicator.innerText = "Promedio: 0 µs";
                return;
            }

            const maxPoints = 60;
            const pointsData = executionTimes.slice(-maxPoints);

            const sum = pointsData.reduce((a, b) => a + b, 0);
            const avg = Math.round(sum / pointsData.length);
            if (avgIndicator) {
                avgIndicator.innerText = `Promedio: ${avg} µs`;
            }

            const maxVal = Math.max(...pointsData, 100);
            const minVal = 0;

            const width = 500;
            const height = 180;
            const margin = { left: 35, right: 15, top: 15, bottom: 15 };

            const chartWidth = width - margin.left - margin.right;
            const chartHeight = height - margin.top - margin.bottom;

            let svgContent = "";

            const gridLines = 4;
            for (let i = 0; i <= gridLines; i++) {
                const yVal = margin.top + (chartHeight / gridLines) * i;
                const gridVal = Math.round(
                    maxVal - ((maxVal - minVal) / gridLines) * i,
                );
                svgContent += `
                    <line x1="${margin.left}" y1="${yVal}" x2="${width - margin.right}" y2="${yVal}" stroke="#27272a" stroke-width="0.75" stroke-dasharray="2,2" />
                    <text x="${margin.left - 6}" y="${yVal + 3}" fill="#71717a" font-size="8" font-family="monospace" text-anchor="end">${gridVal}µs</text>
                `;
            }

            const stepX =
                chartWidth /
                (pointsData.length > 1 ? pointsData.length - 1 : 1);
            let pathPoints = [];

            pointsData.forEach((val, i) => {
                const x = margin.left + i * stepX;
                const y =
                    margin.top +
                    chartHeight -
                    ((val - minVal) / (maxVal - minVal)) * chartHeight;
                pathPoints.push(`${x},${y}`);

                svgContent += `
                    <circle cx="${x}" cy="${y}" r="2" fill="var(--color-accent, #4650ff)" opacity="0.8" />
                `;
            });

            if (pathPoints.length > 0) {
                svgContent += `
                    <path d="M ${pathPoints.join(" L ")}" stroke="var(--color-accent, #4650ff)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                `;
                const fillPath = `M ${margin.left},${margin.top + chartHeight} L ${pathPoints.join(" L ")} L ${margin.left + (pointsData.length - 1) * stepX},${margin.top + chartHeight} Z`;
                svgContent += `
                    <path d="${fillPath}" fill="var(--color-accent, #4650ff)" fill-opacity="0.1" stroke="none" />
                `;
            }

            svg.innerHTML = svgContent;
        }

        document.querySelectorAll(".tab-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".tab-btn").forEach((b) => {
                    b.classList.remove("border-primary", "text-primary");
                    b.classList.add(
                        "border-transparent",
                        "text-muted-foreground",
                    );
                });

                document.querySelectorAll(".tab-content").forEach((c) => {
                    c.classList.remove("block");
                    c.classList.add("hidden");
                });
                btn.classList.add("border-primary", "text-primary");
                btn.classList.remove(
                    "border-transparent",
                    "text-muted-foreground",
                );

                const targetTab = btn.getAttribute("data-tab");
                document.getElementById(targetTab).classList.remove("hidden");
                document.getElementById(targetTab).classList.add("block");

                if (targetTab === "tab-analytics") {
                    renderFrequencyChart();
                    renderSpeedChart();
                }
            });
        });

        document.querySelectorAll(".keyboard-key").forEach((keyBtn) => {
            keyBtn.addEventListener("click", () => {
                const char = keyBtn.getAttribute("data-key");
                encryptSingleChar(char);
            });
        });

        document.addEventListener("keydown", (e) => {
            if (
                document.activeElement.tagName === "TEXTAREA" ||
                document.activeElement.tagName === "INPUT"
            ) {
                return;
            }

            const key = e.key.toUpperCase();
            if (key.length === 1 && ALPHABET.includes(key)) {
                e.preventDefault();
                const keyBtn = document.querySelector(
                    `.keyboard-key[data-key="${key}"]`,
                );
                if (keyBtn) {
                    keyBtn.classList.add("active");
                    keyBtn.click();
                    setTimeout(() => {
                        keyBtn.classList.remove("active");
                    }, 100);
                }
            }
        });

        document.querySelectorAll(".plugboard-socket").forEach((sock) => {
            sock.addEventListener("click", () => {
                const char = sock.getAttribute("data-plug");
                handlePlugboardClick(char);
            });
        });

        document
            .getElementById("btn-clear-plugs")
            .addEventListener("click", () => {
                plugboardPairs = [];
                activePlugSocket = null;
                applyMachineConfigToPython();
            });

        for (let i = 0; i < 3; i++) {
            document
                .getElementById(`rotor-select-${i}`)
                .addEventListener("change", (e) => {
                    const val = parseInt(e.target.value);
                    currentRotors[i] = val;

                    const uniqueRotors = new Set(currentRotors);
                    if (uniqueRotors.size !== 3) {
                        alert(
                            "Cada rotor seleccionado debe ser único. Elige tipos de rotores distintos.",
                        );

                        const options = Array.from(e.target.options);
                        for (let opt of options) {
                            const optVal = parseInt(opt.value);
                            if (!currentRotors.includes(optVal)) {
                                currentRotors[i] = optVal;
                                e.target.value = optVal;
                                break;
                            }
                        }
                    }

                    applyMachineConfigToPython();
                });
        }

        document.querySelectorAll(".rotor-btn-prev").forEach((btn) => {
            btn.addEventListener("click", () => {
                const rIdx = parseInt(btn.getAttribute("data-rotor"));
                rotorPositions[rIdx] = (rotorPositions[rIdx] - 1 + 26) % 26;
                applyMachineConfigToPython();
                updateRotorScrollDisplay(rIdx);
            });
        });

        document.querySelectorAll(".rotor-btn-next").forEach((btn) => {
            btn.addEventListener("click", () => {
                const rIdx = parseInt(btn.getAttribute("data-rotor"));
                rotorPositions[rIdx] = (rotorPositions[rIdx] + 1) % 26;
                applyMachineConfigToPython();
                updateRotorScrollDisplay(rIdx);
            });
        });

        document.getElementById("btn-run-all").addEventListener("click", () => {
            encryptBulkBlock();
        });
        document
            .getElementById("btn-reset-rotors")
            .addEventListener("click", () => {
                rotorPositions = [0, 0, 0];
                applyMachineConfigToPython();
                for (let i = 0; i < 3; i++) {
                    updateRotorScrollDisplay(i);
                }
                alert("Rotores restablecidos a la posición inicial (A-A-A).");
            });

        document.getElementById("btn-copy").addEventListener("click", () => {
            const outTxt = document.getElementById("output-text");
            if (outTxt.value.length === 0) {
                alert("No hay texto para copiar.");
                return;
            }
            navigator.clipboard
                .writeText(outTxt.value)
                .then(() => {
                    alert("¡Cifrado copiado al portapapeles con éxito!");
                })
                .catch((err) => {
                    alert("Error al copiar: " + err);
                });
        });

        document
            .getElementById("btn-clear-console")
            .addEventListener("click", () => {
                document.getElementById("input-text").value = "";
                document.getElementById("output-text").value = "";
                executionTimes = [];
                renderFrequencyChart();
                renderSpeedChart();
            });

        document
            .getElementById("btn-clear-history")
            .addEventListener("click", () => {
                if (
                    confirm(
                        "¿Estás seguro de que quieres borrar el historial de encriptación?",
                    )
                ) {
                    historyData = [];
                    localStorage.removeItem("enigma_history");
                    renderHistoryTable();
                }
            });

        document.getElementById("input-text").addEventListener("input", (e) => {
            const val = e.target.value.toUpperCase();
            const filtered = val
                .split("")
                .filter((c) => ALPHABET.includes(c))
                .join("");
            if (val !== filtered) {
                e.target.value = filtered;
            }
        });

        for (let ri = 0; ri < 5; ri++) {
            const btn = document.getElementById(`btn-regen-rotor-${ri}`);
            if (btn) {
                btn.addEventListener("click", ((rotorIndex) => () => {
                    regenerateRotor(rotorIndex);
                })(ri));
            }
        }

        document.getElementById("btn-regen-reflector").addEventListener("click", () => {
            regenerateReflector();
        });

        document.getElementById("btn-regen-all").addEventListener("click", () => {
            for (let ri = 0; ri < 5; ri++) {
                regenerateRotor(ri);
            }
            regenerateReflector();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => {
                setTimeout(initEnigma, 100);
            });
        } else {
            setTimeout(initEnigma, 100);
        }
    </script>
</Layout>

