---
const features = [
    {
        icon: "rocket",
        title: "Aprende Rápido",
        description: "Experimenta y aprende conceptos científicos de forma práctica e interactiva",
        color: "primary",
    },
    {
        icon: "shield",
        title: "100% Seguro",
        description: "Todos los experimentos son virtuales. Sin riesgos, sin peligros, solo diversión",
        color: "accent",
    },
    {
        icon: "users",
        title: "Para Todos",
        description: "Desde principiantes hasta expertos. Hay experimentos para cada nivel",
        color: "success",
    },
    //{
    //    icon: "trophy",
    //    title: "Gana Insignias",
    //    description: "Completa experimentos y desbloquea logros mientras aprendes",
    //    color: "success",
    //},
];

const icons = {
    rocket: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>',
    shield: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>',
    users: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>',
    trophy: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>',
};
---

<section class="py-20 md:py-32 px-4">
    <div class="container mx-auto max-w-7xl">
        <div class="text-center space-y-6 mb-16">
            <h2 class="text-5xl md:text-7xl lg:text-8xl font-black leading-tight">
                ¿Por qué <span class="text-accent">Elegirnos</span>?
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {features.map((feature, index) => (
                <div
                    class="flex flex-col items-center text-center space-y-6 p-8 rounded-3xl bg-background/80 backdrop-blur-sm border-0 hover:border-primary/50 transition-all hover:scale-110 hover:-translate-y-2 cursor-pointer group shadow-xl hover:shadow-2xl animate-slide-up"
                    style={`animation-delay: ${index * 0.1}s;`}
                >
                    <div class={`p-6 rounded-3xl shadow-2xl group-hover:rotate-[360deg] group-hover:scale-125 transition-all duration-500
                        ${feature.color === 'primary' ? 'bg-primary text-primary-foreground shadow-primary/50' : ''}
                        ${feature.color === 'accent' ? 'bg-accent text-accent-foreground shadow-accent/50' : ''}
                        ${feature.color === 'secondary' ? 'bg-secondary text-secondary-foreground shadow-secondary/50' : ''}
                        ${feature.color === 'success' ? 'bg-success text-success-foreground shadow-success/50' : ''}
                    `}>
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[feature.icon as keyof typeof icons]} />
                    </div>
                    <div class="hidden group-hover:text-success group-hover:text-primary group-hover:text-secondary group-hover:text-accent"></div>
                    <h3 class={`text-2xl font-black group-hover:text-${feature.color} transition-colors`}>{feature.title}</h3>
                    <p class="text-base text-foreground/70 leading-relaxed font-medium">{feature.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>
