    <script is:inline>
        let pyodide = null;
        let enigmaJS = null;

        let currentRotors = [0, 1, 2];
        let rotorPositions = [0, 0, 0];
        let plugboardPairs = [];
        let activePlugSocket = null;
        let executionTimes = [];
        let historyData = [];

        const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

        const QWERTZ_FLAT = ["Q","W","E","R","T","Z","U","I","O","A","S","D","F","G","H","J","K","P","Y","X","C","V","B","N","M","L"];

        const WIRE_COLORS = [
            "#ff141e", // Primary Red
            "#4650ff", // Accent Blue
            "#00d084", // Success Green
            "#ffff14", // Secondary Yellow
            "#f43f5e", // Rose
            "#a855f7", // Purple
            "#3b82f6", // Blue
            "#ec4899", // Pink
            "#f97316", // Orange
            "#14b8a6", // Teal
            "#84cc16", // Lime
            "#06b6d4", // Cyan
        ];

        function initRotorScrolls() {
            for (let i = 0; i < 3; i++) {
                updateRotorScrollDisplay(i);
            }
        }

        function updateRotorScrollDisplay(rotorIdx) {
            const container = document.getElementById(
                `rotor-scroll-${rotorIdx}`,
            );
            if (!container) return;

            const pos = rotorPositions[rotorIdx];

            let lettersHTML = "";
            for (let offset = -2; offset <= 2; offset++) {
                const charIdx = (pos + offset + 26) % 26;
                const letter = ALPHABET[charIdx];
                const isCurrent = offset === 0;

                lettersHTML += `<span class="h-8 flex items-center justify-center transition-all duration-150 ${isCurrent ? "text-amber-500 font-extrabold text-lg" : "text-zinc-600 opacity-40 text-xs"}">${letter}</span>`;
            }

            container.innerHTML = lettersHTML;
        }

        async function initEnigma() {
            const statusEl = document.getElementById("loading-status");
            try {
                if (typeof globalThis.loadPyodide === "undefined") {
                    throw new Error(
                        "loadPyodide no está disponible. Revisa tu conexión a internet.",
                    );
                }

                statusEl.innerText = "Inicializando WebAssembly...";
                pyodide = pyodide || (await globalThis.loadPyodide());

                statusEl.innerText = "Compilando lógica Enigma en Python...";
                const pythonCode = `
import random

LETTERS = 'abcdefghijklmnopqrstuvwxyz'

def charToPosition(char: str)->int:
    if len(char) != 1: raise ValueError("Character must be a single letter")
    if char.lower() not in LETTERS: raise ValueError("Character must be a letter")
    return LETTERS.index(char.lower())

def positionToChar(position: int)->str:
    if position < 0 or position >= 26: raise ValueError("Position must be between 0 and 25")
    return LETTERS[position]

def length(): return len(LETTERS)

def checkMapping(mapping: list[int])->bool: 
    return len(mapping) == length() and len(set(mapping)) == length()

def rotate(positions:list[int], times:int=1)->list[int]:
    if times <= 0: return positions
    if times > len(positions): return rotate(positions, times % len(positions))
    if times == len(positions): return positions
    return positions[times:] + positions[:times]

def checkListUnique(list:list)->bool: return len(set(list)) == len(list)

def checkListPermutation(list:list, domain:list[int]=None)->bool:
    if domain is None: domain = range(len(list))
    elif not checkListUnique(domain): raise ValueError("Domain must be unique")
    return checkListUnique(list) and all(i in list for i in domain)

def generateRandomPairList(size:int=26)->list[int]:
    letters = list(range(size))
    random.shuffle(letters)
    reflector = [0] * size
    while letters:
        a = letters.pop()
        if letters:
            b = letters.pop()
            reflector[a] = b
            reflector[b] = a
        else:
            # Imposible con 26 (par), pero por seguridad
            reflector[a] = a
    return reflector

class BaseSwapper:
    def swap(self, positions: list[int], letter: int)->int:
        if not checkListPermutation(positions, range(len(positions))): raise ValueError("Positions must be a permutation of 0-25")
        return positions[letter]
    def inverseSwap(self, positions: list[int], letter: int)->int:
        if not checkListPermutation(positions, range(len(positions))): raise ValueError("Positions must be a permutation of 0-25")
        return positions.index(letter)

class Swapper(BaseSwapper):
    def __init__(self, positions:list[int]=None):
        super().__init__()
        self.__positions = positions if positions else [i for i in range(26)]
    def swap(self, letter: int, positions:list[int]=None)->int: 
        return super().swap(self.__positions if positions is None else positions, letter)
    def inverseSwap(self, letter: int, positions:list[int]=None)->int: 
        return super().inverseSwap(self.__positions if positions is None else positions, letter)
    def mix(self): random.shuffle(self.__positions)
    def unmix(self): self.__positions = [i for i in range(26)]
    @property
    def positions(self)->list[int]: return self.__positions
    @positions.setter
    def positions(self, positions:list[int]):
        if not checkListPermutation(positions, range(26)): raise ValueError("Positions must be a permutation of 0-25")
        self.__positions = positions

class Rotor(Swapper):
    def __init__(self, position: int=0):
        super().__init__()
        self.position = position
    def swap(self, letter: int): return super().swap(letter, rotate(self.positions, self.position))
    def inverseSwap(self, letter: int): return super().inverseSwap(letter, rotate(self.positions, self.position))
    def rotate(self):
        self.position += 1
        if self.position >= len(self.positions): self.position = 0
    def unrotate(self):
        self.position -= 1
        if self.position < 0: self.position = len(self.positions) - 1
    def reset(self): self.position = 0

class RotorsGroup:
    def __init__(self, rotors: list[Rotor]): self.rotors = rotors
    def swap(self, letter: int):
        for rotor in self.rotors: letter = rotor.swap(letter)
        return letter
    def inverseSwap(self, letter: int):
        for rotor in reversed(self.rotors): letter = rotor.inverseSwap(letter)
        return letter
    def rotate(self):
        for rotor in self.rotors:
            rotor.rotate()
            if rotor.position != 0: break
    def reset(self): [rotor.reset() for rotor in self.rotors]

class PlugBoard(Swapper):
    def __init__(self, mapping: list[int]=None):
        if mapping is None: mapping = [i for i in range(26)]
        super().__init__(mapping)
    def reMap(self, mapping: list[int]):
        if not checkMapping(mapping): raise ValueError("Mapping must be of length 26")
        self.positions = mapping
    def swapPins(self, a: int, b: int):
        if a == b: raise ValueError("Cannot swap a pin with itself")
        if self.positions[a] == b and self.positions[b] == a: return
        if a != self.positions[a] or b != self.positions[b]: raise ValueError("Cannot swap a pin that is already swapped")
        temp = self.positions[a]
        self.positions[a] = self.positions[b]
        self.positions[b] = temp
    def unswapPin(self, pin: int):
        if self.positions[pin] == pin: return
        temp = self.positions[pin]
        self.positions[pin] = pin
        self.positions[temp] = temp
    def reset(self): self.positions = [i for i in range(26)]

class EnigmaMachine:
    def __init__(self):
        self.plugboard = PlugBoard()
        self.rotors = [Rotor(0) for _ in range(5)]
        self.reflector = Swapper()
        # Inicializar rotores de forma consistente, pero aleatoria por sesión
        for r in self.rotors: r.mix()
        self.reflector.positions = generateRandomPairList()
        self.rotorGroup = RotorsGroup(self.rotors[:3])
        
    def selectRotors(self, rotors: list[int]):
        if len(rotors) != 3: raise ValueError("Select 3 rotors")
        if not checkListUnique(rotors): raise ValueError("Rotor indices must be unique")
        if not all(0 <= i <= 4 for i in rotors): raise ValueError("Rotor indices must be in range 0-4")
        self.rotorGroup = RotorsGroup([self.rotors[i] for i in rotors])
        
    def loadPositions(self, positions: list[int]):
        if len(positions) != 3: raise ValueError("Select 3 positions")
        if not all(0 <= p <= 25 for p in positions): raise ValueError("Positions must be in range 0-25")
        for r, p in zip(self.rotorGroup.rotors, positions): r.position = p
        
    def loadPins(self, pins: list[list[int,int]]):
        _pins = [p for pair in pins for p in pair]
        if not checkListPermutation(_pins, range(26)): raise ValueError("Pins must be a permutation of 0-25")
        for p in pins: self.plugboard.swapPins(p[0], p[1])
        
    def step(self, letter:str)->str:
        letter = charToPosition(letter)
        self.rotorGroup.rotate()
        letter = self.plugboard.swap(letter)
        letter = self.rotorGroup.swap(letter)
        letter = self.reflector.swap(letter)
        letter = self.rotorGroup.inverseSwap(letter)
        letter = self.plugboard.swap(letter)
        return positionToChar(letter)
        
    def run(self, message:str)->str: 
        return ''.join([self.step(c) for c in message])
        
    def reset(self):
        self.plugboard.reset()
        for r in self.rotors: r.reset()
        
    def step_trace(self, letter:str)->dict:
        rotors_before = [r.position for r in self.rotorGroup.rotors]
        self.rotorGroup.rotate()
        rotors_after = [r.position for r in self.rotorGroup.rotors]
        char_in = letter.lower()
        pos_in = charToPosition(char_in)
        pos_pb1 = self.plugboard.swap(pos_in)
        char_pb1 = positionToChar(pos_pb1)
        pos_r = pos_pb1
        rotor_steps_forward = []
        for rotor in self.rotorGroup.rotors:
            pos_r = rotor.swap(pos_r)
            rotor_steps_forward.append(positionToChar(pos_r))
        pos_refl = self.reflector.swap(pos_r)
        char_refl = positionToChar(pos_refl)
        pos_rinv = pos_refl
        rotor_steps_backward = []
        for rotor in reversed(self.rotorGroup.rotors):
            pos_rinv = rotor.inverseSwap(pos_rinv)
            rotor_steps_backward.append(positionToChar(pos_rinv))
        pos_pb2 = self.plugboard.swap(pos_rinv)
        char_out = positionToChar(pos_pb2)
        return {
            "rotors_before": rotors_before,
            "rotors_after": rotors_after,
            "input": char_in.upper(),
            "plugboard_in": char_pb1.upper(),
            "rotors_forward": [c.upper() for c in rotor_steps_forward],
            "reflector": char_refl.upper(),
            "rotors_backward": [c.upper() for c in rotor_steps_backward],
            "plugboard_out": char_out.upper(),
            "output": char_out.upper()
        }

