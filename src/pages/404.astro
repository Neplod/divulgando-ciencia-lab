---
import MainLayout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icons.astro";
import { clientTranslations } from "../i18n";
const t = clientTranslations["es"];
---

<MainLayout title={t.titles.notFound} is404={true}>
    <div
        class="container flex flex-col items-center justify-center! min-h-screen min-w-screen py-16 text-center"
    >
        <h1 class="text-6xl font-bold mb-4">404</h1>
        <h2 class="text-2xl font-semibold mb-6">{t.notFound.title}</h2>
        <p class="text-muted-foreground max-w-md mb-8">
            {t.notFound.message}
        </p>
        <Button id="back-button">
            <Icon icon="arrowleft" className="mr-2 h-4 w-4" />
            {t.common.back}
        </Button>
        <div
            class="absolute bottom-0 w-full px-10 pb-8 grid grid-cols-1 md:grid-cols-3 gap-4 items-center text-sm text-muted-foreground font-medium"
        >
            <div class="hidden md:block"></div>
            <div class="text-center">
                <a href="/terms" class="hover:text-primary transition-colors"
                    >Términos y Condiciones</a
                >
            </div>
            <div class="text-center md:text-right">
                © Divulgando Ciencia. <a
                    href="https://creativecommons.org/licenses/by-nc/4.0/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary transition-colors">CC BY-NC 4.0</a
                >
            </div>
        </div>
    </div>
    <script>
        document
            .getElementById("back-button")
            .addEventListener("click", function () {
                window.history.back();
            });
    </script>
</MainLayout>
